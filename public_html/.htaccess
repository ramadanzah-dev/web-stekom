Options -Indexes +FollowSymLinks
RewriteEngine On

# Jika file atau folder fisik benar-benar ada di public_html, biarkan diakses langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alihkan semua request lainnya ke index.php
RewriteCond %{REQUEST_URI} !^/cek-db\.php$
RewriteRule ^ index.php [L]
